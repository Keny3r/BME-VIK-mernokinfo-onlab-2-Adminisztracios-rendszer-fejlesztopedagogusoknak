@page "/profil"
@using BTMNAdmin.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using System.Security.Claims

@rendermode InteractiveServer
@using BTMNAdmin.Data
@using BTMNAdmin.Components.Shared

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject FejlesztopedagogusService FejlesztopedagogusService

<PageTitle>Profil – BTMN Admin</PageTitle>

<h1><i class="bi bi-person-fill text-primary me-2" aria-hidden="true"></i>Profil</h1>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">Fejlesztőpedagógus neve</h2>
        @if (pedagogus is null)
        {
            <p class="text-danger mb-0">Nem található pedagógusprofil ehhez a felhasználóhoz.</p>
        }
        else
        {
            <div class="d-flex align-items-center justify-content-between gap-3">
                <p class="text-muted mb-0">@pedagogus.Nev</p>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        aria-label="Név szerkesztése"
                        title="Név szerkesztése"
                        @onclick="OpenNameEditor">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
            </div>
        }
    </div>
</div>

<FejlesztopedagogusModal IsOpen="isNameEditorOpen"
                         Nev="@(pedagogus?.Nev)"
                         OnSaved="ReloadPedagogus"
                         OnClose="CloseNameEditor" />

<LabelSection TLabel="Tanev" />
<LabelSection TLabel="Iskola" />
<LabelSection TLabel="Szakszolgalat" />

@code {
    private Fejlesztopedagogus? pedagogus;
    private bool isNameEditorOpen;

    protected override async Task OnInitializedAsync()
    {
        await ReloadPedagogus();
    }

    private void OpenNameEditor() => isNameEditorOpen = true;

    private void CloseNameEditor() => isNameEditorOpen = false;

    private async Task ReloadPedagogus()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId is not null)
            pedagogus = await FejlesztopedagogusService.GetFejlesztopedagogusAsync(userId);
    }
}